# ── Telegram ──────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your-bot-token-here
# Your numeric chat ID (message the bot, then check getUpdates)
TELEGRAM_CHAT_ID=your-chat-id-here

# ── HyperEVM RPC ──────────────────────────────────────────
HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm

# ── Polling ───────────────────────────────────────────────
# How often to poll RPC (seconds)
POLL_INTERVAL_SECONDS=3
# Max blocks to scan per poll (wider = fewer polls but bigger responses)
BLOCKS_PER_POLL=50

# ── State file ────────────────────────────────────────────
STATE_FILE=state.json
